#!/usr/bin/env bash

# git-overview - Quick status of all your git and jj repos

set -o pipefail

TEMP_DIRS=()
cleanup() {
    local dir
    for dir in "${TEMP_DIRS[@]}"; do
        [[ -n "$dir" ]] && rm -rf "$dir"
    done
}
trap cleanup EXIT

# Requires bash 4.3+ (namerefs, associative arrays, `wait -n`).
# macOS ships bash 3.2 — install a newer one with `brew install bash`.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    echo "git-overview requires bash 4.3+" >&2
    exit 1
fi

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
CYAN='\033[36m'
DIM='\033[90m'
BOLD='\033[1m'
RESET='\033[0m'

SYM_DIRTY="○"
SYM_CLEAN="◆"
SYM_STASH="◇"

MAX_DEPTH=2
NO_COLOR=false
SHOW_CLEAN=true
SORT_BY="name"
FETCH=false
FETCH_JOBS=8
FETCH_TIMEOUT=10
SCAN_JOBS=8

UPGRADE_URL="https://raw.githubusercontent.com/oskarrough/git-overview/main/git-overview"

usage() {
    echo "Usage: $(basename "$0") [options] [directory]"
    echo "       $(basename "$0") upgrade"
    echo ""
    echo "Options:"
    echo "  -d N, --depth N  Search depth (default: 2)"
    echo "  -t               Sort by time (recent first)"
    echo "  -a               Only show repos needing attention"
    echo "  -f, --fetch      Fetch from remotes before scanning (parallel)"
    echo "  --no-color       Disable colors"
    echo "  -h, --help       Show this help"
    echo ""
    echo "Commands:"
    echo "  upgrade          Download latest version from GitHub"
    exit "${1:-0}"
}

upgrade() {
    local path tmp
    path=$(realpath "$0")
    [[ -d $(dirname "$path")/.git ]] && { echo "Git checkout — run 'git pull' in $(dirname "$path")"; exit 1; }

    tmp=$(mktemp) && trap 'rm -f "$tmp"' EXIT
    curl -fsSL "$UPGRADE_URL" -o "$tmp" || { echo "Download failed"; exit 1; }
    head -1 "$tmp" | grep -q '^#!' || { echo "Bad payload"; exit 1; }
    cmp -s "$tmp" "$path" && { echo "Already latest."; exit 0; }

    chmod +x "$tmp" && mv "$tmp" "$path" && echo "Upgraded $path"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        upgrade) upgrade; exit ;;
        -d|--depth)
            [[ $# -ge 2 ]] || { echo "Missing depth value" >&2; exit 1; }
            MAX_DEPTH="$2"
            shift 2
            ;;
        --depth=*)
            MAX_DEPTH="${1#*=}"
            shift
            ;;
        -t) SORT_BY="time"; shift ;;
        -a) SHOW_CLEAN=false; shift ;;
        -f|--fetch) FETCH=true; shift ;;
        --no-color) NO_COLOR=true; shift ;;
        -h|--help) usage ;;
        -[tafh]*)
            short_options="${1#-}"
            while [[ -n "$short_options" ]]; do
                option="${short_options:0:1}"
                short_options="${short_options:1}"
                case "$option" in
                    t) SORT_BY="time" ;;
                    a) SHOW_CLEAN=false ;;
                    f) FETCH=true ;;
                    h) usage ;;
                    *) echo "Unknown: -$option" >&2; usage 1 ;;
                esac
            done
            shift
            ;;
        -*) echo "Unknown: $1" >&2; usage 1 ;;
        *) TARGET="$1"; shift ;;
    esac
done

TARGET="${TARGET:-.}"
[[ "$MAX_DEPTH" =~ ^0*[0-9]{1,3}$ ]] || { echo "Invalid depth: $MAX_DEPTH" >&2; exit 1; }
MAX_DEPTH=$((10#$MAX_DEPTH))
(( MAX_DEPTH <= 100 )) || { echo "Depth is too large: $MAX_DEPTH" >&2; exit 1; }

[[ "$NO_COLOR" == true ]] && RED="" GREEN="" YELLOW="" CYAN="" DIM="" BOLD="" RESET=""

trunc() {
    local str="$1" max="$2"
    [[ ${#str} -gt $max ]] && echo "${str:0:$((max-1))}…" || echo "$str"
}

append() {
    # append a detail token, space-separated
    local -n _ref=$1
    [[ -n "$_ref" ]] && _ref+=" "
    _ref+="$2"
}

relpath() {
    # path of $1 relative to ancestor $2 (portable; BSD realpath lacks --relative-to)
    local dir="$1" base="$2" rel="${1#"$2"/}"
    [[ "$rel" == "$dir" ]] && rel=$(basename "$dir")
    echo "$rel"
}

get_repo_info_jj() {
    local dir="$1" base="$2"
    local name branch commit status="clean" details=""

    name=$(relpath "$dir" "$base")
    cd "$dir" 2>/dev/null || return 1

    # Gather working-copy identity, changed-file count, publication state,
    # divergence, and timestamp in one jj process.
    local metadata kind field_branch field_commit field_modified field_conflicted field_timestamp field_time
    local has_remote=0 modified=0 conflicted=0 ahead=0 behind=0 timestamp time
    metadata=$(jj log -r '@ | remote_bookmarks(glob:"main") | remote_bookmarks(glob:"master") | (trunk()..@ ~ empty()) | (@..trunk())' --no-graph \
        --template 'if(self.current_working_copy(), "W|" ++ bookmarks ++ "|" ++ commit_id.short(8) ++ "|" ++ if(!self.empty() && !self.contained_in("::remote_bookmarks()"), self.diff().files().len(), "0") ++ "|" ++ self.conflicted_files().len() ++ "|" ++ committer.timestamp().utc().format("%s") ++ "|" ++ committer.timestamp().ago() ++ "\n") ++ if(self.contained_in("remote_bookmarks(glob:\"main\") | remote_bookmarks(glob:\"master\")"), "R\n") ++ if(self.contained_in("trunk()..@ ~ empty()"), "A\n") ++ if(self.contained_in("@..trunk()"), "B\n")' \
        2>/dev/null) || return 1
    while IFS='|' read -r kind field_branch field_commit field_modified field_conflicted field_timestamp field_time; do
        case "$kind" in
            W)
                branch=$field_branch
                commit=$field_commit
                modified=$field_modified
                conflicted=$field_conflicted
                timestamp=$field_timestamp
                time=$field_time
                [[ -z "$branch" ]] && branch=$commit
                ;;
            R) has_remote=1 ;;
            A) ((ahead++)) ;;
            B) ((behind++)) ;;
        esac
    done <<< "$metadata"

    if (( modified > 0 )); then
        append details "M:$modified"
        status="dirty"
    fi
    if (( conflicted > 0 )); then
        append details "U:$conflicted"
        status="dirty"
    fi

    if (( has_remote )); then
        (( ahead > 0 )) && append details "↑$ahead" && status="dirty"
        (( behind > 0 )) && append details "↓$behind" && status="dirty"
    fi

    time=${time% ago}
    time=${time%%, *}
    [[ -z "$timestamp" ]] && timestamp="0" && time="–"

    echo "$name|$branch|$status|$details|$time|$timestamp"
}

get_repo_info_git() {
    local dir="$1" base="$2"
    local name branch oid status="clean" details=""

    name=$(relpath "$dir" "$base")

    cd "$dir" 2>/dev/null || return 1

    # A .git directory can be a leftover empty shell; skip non-repos quietly.
    git rev-parse --git-dir >/dev/null 2>&1 || return 0

    # Porcelain v2 includes branch, upstream divergence, stash count, and file
    # state, replacing five separate git invocations with one.
    local porcelain line xy index_state worktree_state
    local changes=0 modified=0 staged=0 untracked=0 conflicted=0 stashes=0 ahead=0 behind=0
    porcelain=$(git status --porcelain=v2 --branch --show-stash 2>/dev/null) || return 1
    while IFS= read -r line; do
        case "$line" in
            '# branch.oid '*) oid=${line#\# branch.oid } ;;
            '# branch.head '*) branch=${line#\# branch.head } ;;
            '# branch.ab '*)
                read -r ahead behind <<< "${line#\# branch.ab }"
                ahead=${ahead#+}
                behind=${behind#-}
                ;;
            '# stash '*) stashes=${line#\# stash } ;;
            '1 '*|'2 '*|'u '*)
                ((changes++))
                xy=${line:2:2}
                index_state=${xy:0:1}
                worktree_state=${xy:1:1}
                if [[ "$line" == 'u '* ]]; then
                    ((conflicted++))
                else
                    [[ "$worktree_state" == "M" || ( "$index_state" == "M" && "$worktree_state" == "." ) ]] && ((modified++))
                    [[ "$index_state" == [MADRC] ]] && ((staged++))
                fi
                ;;
            '? '*) ((changes++)); ((untracked++)) ;;
        esac
    done <<< "$porcelain"

    [[ "$branch" == "(detached)" ]] && branch=$(git rev-parse --short "$oid" 2>/dev/null || echo "?")
    [[ -z "$branch" ]] && branch=$(git rev-parse --short HEAD 2>/dev/null || echo "?")

    if (( changes > 0 )); then
        (( modified > 0 )) && append details "M:$modified"
        (( staged > 0 )) && append details "S:$staged"
        (( untracked > 0 )) && append details "?:$untracked"
        (( conflicted > 0 )) && append details "U:$conflicted"
        status="dirty"
    fi

    if (( stashes > 0 )); then
        append details "stash:$stashes"
        [[ "$status" == "clean" ]] && status="stash"
    fi

    (( ahead > 0 )) && append details "↑$ahead"
    (( behind > 0 )) && append details "↓$behind"

    local timestamp time
    read -r timestamp time <<< "$(git log -1 --format="%ct %cr" 2>/dev/null | sed 's/ ago//; s/, .*//')"
    [[ -z "$timestamp" ]] && timestamp="0" && time="–"

    echo "$name|$branch|$status|$details|$time|$timestamp"
}

get_repo_info() {
    local dir="$1" base="$2"
    if [[ -d "$dir/.jj" ]]; then
        get_repo_info_jj "$dir" "$base"
    else
        get_repo_info_git "$dir" "$base"
    fi
}

# Run `worker <item> <extra args…>` once per element of the array named $1,
# keeping at most $2 jobs in flight. Each job's stdout goes to
# $RESULTS_DIR/<index>, and $RESULTS_DIR/<index>.ok exists only if it exited 0,
# so callers can read results back in order and spot the failures. The results
# directory is returned in the RESULTS_DIR global rather than on stdout, because
# a command substitution would run the fan-out in a subshell and lose both the
# jobs and the TEMP_DIRS registration.
RESULTS_DIR=""
parallel_map() {
    local -n _items=$1
    local max_jobs=$2 worker=$3
    shift 3

    RESULTS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/git-overview.XXXXXX") || return 1
    TEMP_DIRS+=("$RESULTS_DIR")

    local item index=0 active=0
    for item in "${_items[@]}"; do
        ("$worker" "$item" "$@" > "$RESULTS_DIR/$index" && touch "$RESULTS_DIR/$index.ok") &
        ((index++))
        if (( ++active >= max_jobs )); then
            wait -n 2>/dev/null || true
            ((active--))
        fi
    done
    wait 2>/dev/null || true
}

fetch_repo() {
    local dir="$1" timeout_command="$2"
    if [[ -d "$dir/.jj" ]]; then
        (cd "$dir" && GIT_TERMINAL_PROMPT=0 "$timeout_command" "${FETCH_TIMEOUT}s" jj git fetch --quiet >/dev/null 2>&1)
    else
        (cd "$dir" && GIT_TERMINAL_PROMPT=0 "$timeout_command" "${FETCH_TIMEOUT}s" git fetch --quiet --no-tags >/dev/null 2>&1)
    fi
}

fetch_all() {
    local -n _repos=$1
    local count=${#_repos[@]}
    [[ $count -eq 0 ]] && return
    local timeout_command
    if command -v timeout >/dev/null 2>&1; then
        timeout_command=timeout
    elif command -v gtimeout >/dev/null 2>&1; then
        timeout_command=gtimeout
    else
        echo "Fetch requires timeout or gtimeout (install coreutils)" >&2
        return 1
    fi

    echo -e "${DIM}Fetching $count repos (max ${FETCH_JOBS} parallel, ${FETCH_TIMEOUT}s timeout)…${RESET}" >&2
    # A failed fetch is routine (offline, no remote), so the .ok markers are
    # ignored here and the scan reports whatever state it finds.
    parallel_map "$1" "$FETCH_JOBS" fetch_repo "$timeout_command" || return 1
    rm -rf "$RESULTS_DIR"
}

sort_repos() {
    if [[ "$SORT_BY" == "time" ]]; then
        sort -t'|' -k6 -rn
    else
        sort -t'|' -k1
    fi
}

sorted_list() {
    local -n _arr=$1
    [[ ${#_arr[@]} -eq 0 ]] && return
    local sorted=()
    while IFS= read -r line; do
        sorted+=("$line")
    done < <(printf '%s\n' "${_arr[@]}" | sort_repos)
    _arr=("${sorted[@]}")
}

# Emit NUL-separated repository markers (.jj directories, .git directories and
# the .git files that mark worktrees and submodules) under $1, up to depth $2.
find_repo_markers() {
    find "$1" -maxdepth "$2" \( \( -name ".jj" -type d \) -o -name ".git" \) -print0 2>/dev/null
}

# Collect the deduplicated, sorted repository directories under $2 into the
# array named $1.
discover_repos() {
    local -n _repo_dirs=$1
    local target=$2
    local markers=() top_dirs=() marker repo_dir index count

    if (( MAX_DEPTH < 3 )); then
        while IFS= read -r -d '' marker; do
            markers+=("$marker")
        done < <(find_repo_markers "$target" "$((MAX_DEPTH + 1))")
    else
        # Deep scans can enter large dependency trees before reaching max depth,
        # so search the top-level directories concurrently. .git and .jj are
        # skipped: their contents hold no repositories of their own, and the
        # target's own marker is added directly below.
        while IFS= read -r -d '' repo_dir; do
            top_dirs+=("$repo_dir")
        done < <(find "$target" -mindepth 1 -maxdepth 1 -type d ! -name ".git" ! -name ".jj" -print0 2>/dev/null)

        [[ -d "$target/.jj" ]] && markers+=("$target/.jj")
        [[ -e "$target/.git" ]] && markers+=("$target/.git")

        parallel_map top_dirs "$SCAN_JOBS" find_repo_markers "$MAX_DEPTH" || return 1
        count=${#top_dirs[@]}
        for ((index = 0; index < count; index++)); do
            if [[ ! -e "$RESULTS_DIR/$index.ok" ]]; then
                echo "Warning: could not search ${top_dirs[index]}" >&2
                continue
            fi
            while IFS= read -r -d '' marker; do
                markers+=("$marker")
            done < "$RESULTS_DIR/$index"
        done
        rm -rf "$RESULTS_DIR"
    fi

    (( ${#markers[@]} == 0 )) && return

    local -A seen=()
    while IFS= read -r -d '' marker; do
        repo_dir=${marker%/*}
        [[ -n "${seen[$repo_dir]:-}" ]] && continue
        seen[$repo_dir]=1
        _repo_dirs+=("$repo_dir")
    done < <(printf '%s\0' "${markers[@]}" | sort -z)
}

scan_all() {
    local -n _repos=$1 _dirty=$3 _clean=$4
    local base=$2 count=${#_repos[@]}
    [[ $count -eq 0 ]] && return

    parallel_map "$1" "$SCAN_JOBS" get_repo_info "$base" || return 1

    local info row_status index
    for ((index = 0; index < count; index++)); do
        if [[ ! -e "$RESULTS_DIR/$index.ok" ]]; then
            echo "Warning: could not scan ${_repos[index]}" >&2
            continue
        fi
        IFS= read -r info < "$RESULTS_DIR/$index" || true
        [[ -z "$info" ]] && continue
        IFS='|' read -r _ _ row_status _ <<< "$info"
        if [[ "$row_status" == "dirty" || "$row_status" == "stash" ]]; then
            _dirty+=("$info")
        else
            _clean+=("$info")
        fi
    done

    rm -rf "$RESULTS_DIR"
}

main() {
    local target_path
    target_path=$(cd "$TARGET" 2>/dev/null && pwd) || { echo "Error: Cannot access $TARGET"; exit 1; }

    local dirty_repos=() clean_repos=() repo_dirs=()
    discover_repos repo_dirs "$target_path"

    if [[ "$FETCH" == true ]]; then
        fetch_all repo_dirs || exit 1
    fi

    scan_all repo_dirs "$target_path" dirty_repos clean_repos

    sorted_list dirty_repos
    sorted_list clean_repos

    local total=$(( ${#dirty_repos[@]} + ${#clean_repos[@]} ))
    echo -e "${BOLD}$(basename "$target_path")${RESET} ${DIM}($total repos)${RESET}"
    echo ""

    if [[ $total -eq 0 ]]; then
        echo "No git repos found"
        exit 0
    fi

    local info name branch status details time sym color
    for info in "${dirty_repos[@]}"; do
        IFS='|' read -r name branch status details time _ <<< "$info"
        if [[ "$status" == "stash" ]]; then sym=$SYM_STASH; color=$YELLOW
        else sym=$SYM_DIRTY; color=$RED
        fi
        printf "${color}${sym}${RESET} ${BOLD}%-20s${RESET} ${CYAN}%-12s${RESET} ${RED}%-14s${RESET} ${DIM}%s${RESET}\n" \
            "$(trunc "$name" 20)" "$(trunc "$branch" 12)" "$details" "$time"
    done

    if [[ "$SHOW_CLEAN" == true && ${#clean_repos[@]} -gt 0 ]]; then
        [[ ${#dirty_repos[@]} -gt 0 ]] && echo ""
        for info in "${clean_repos[@]}"; do
            IFS='|' read -r name branch status details time _ <<< "$info"
            printf "${GREEN}${SYM_CLEAN}${RESET} ${DIM}%-20s %-12s${RESET}  %-14s ${DIM}%s${RESET}\n" \
                "$(trunc "$name" 20)" "$(trunc "$branch" 12)" "$details" "$time"
        done
    fi

    echo ""
    echo -e "${DIM}${SYM_DIRTY} dirty  ${SYM_STASH} stash  ${SYM_CLEAN} clean  │  M modified  S staged  ? untracked  U conflicted  ↑↓ ahead/behind${RESET}"
}

main
